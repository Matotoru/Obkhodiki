<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders every page with sample data to PNG, without admin rights or a running engine. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZapretHub.App\ZapretHub.App.csproj" />
  </ItemGroup>
</Project>

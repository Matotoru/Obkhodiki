<Page
  x:Class="ZapretHub.App.Ui.Pages.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Главная">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PagePadding}" DataContext="{Binding Home}">

      <!-- Hero: the one switch that matters most. -->
      <ui:Card Padding="28,24" Margin="{StaticResource CardSpacing}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="30" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="13" Text="{Binding StatusSubtitle}" />
          </StackPanel>
          <ui:ToggleSwitch
            Grid.Column="2"
            VerticalAlignment="Center"
            IsChecked="{Binding BypassOn}"
            IsEnabled="{Binding CanToggle}"
            OffContent="Выкл"
            OnContent="Вкл" />
        </Grid>
      </ui:Card>

      <!-- Modules at a glance. -->
      <UniformGrid Columns="3" Margin="-6,0,-6,0">
        <ui:CardAction Margin="6" Command="{Binding NavigateCommand}" CommandParameter="Games">
          <ui:CardAction.Icon>
            <ui:SymbolIcon Symbol="Games24" />
          </ui:CardAction.Icon>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="15" Text="Игры" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding GamesSummary}" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="6" Command="{Binding NavigateCommand}" CommandParameter="Vpn">
          <ui:CardAction.Icon>
            <ui:SymbolIcon Symbol="Globe24" />
          </ui:CardAction.Icon>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="SemiBold" FontSize="15" Text="VPS" />
              <Ellipse Width="8" Height="8" Margin="8,2,0,0" Fill="#6CCB5F" Visibility="{Binding VpnOn, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding VpnSummary}" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="6" Command="{Binding NavigateCommand}" CommandParameter="Telegram">
          <ui:CardAction.Icon>
            <ui:SymbolIcon Symbol="Send24" />
          </ui:CardAction.Icon>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="SemiBold" FontSize="15" Text="Telegram" />
              <Ellipse Width="8" Height="8" Margin="8,2,0,0" Fill="#6CCB5F" Visibility="{Binding TelegramOn, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding TelegramSummary}" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>

      <ui:InfoBar
        Margin="0,12,0,0"
        IsClosable="False"
        IsOpen="True"
        Severity="Informational"
        Title="Доступны обновления"
        Message="Откройте «Настройки», чтобы посмотреть и установить."
        Visibility="{Binding UpdatesAvailable, Converter={StaticResource CountToVisibility}}" />

      <TextBlock Style="{StaticResource SectionTitle}" Text="События" />
      <ui:Card Padding="0">
        <Grid>
          <ItemsControl ItemsSource="{Binding DataContext.Events, RelativeSource={RelativeSource AncestorType=Page}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource EventKindToSymbol}}" Foreground="{Binding Kind, Converter={StaticResource EventKindToBrush}}" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding TimeText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock
            Margin="16,14"
            Style="{StaticResource Caption}"
            Text="Пока ничего не произошло."
            Visibility="{Binding DataContext.Events.Count, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource CountToVisibility}, ConverterParameter=zero}" />
        </Grid>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</Page>

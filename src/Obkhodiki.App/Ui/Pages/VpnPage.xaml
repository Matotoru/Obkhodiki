<Page
  x:Class="Obkhodiki.App.Ui.Pages.VpnPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="VPS">
  <Page.Resources>
    <!-- One side of the quality comparison. -->
    <DataTemplate x:Key="PathStatsTemplate">
      <Border Padding="18,14" CornerRadius="8" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsWinner}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <UniformGrid Columns="3">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Пинг" />
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Ping}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Джиттер" />
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Jitter}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Потери" />
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Loss}" />
          </StackPanel>
        </UniformGrid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CategoryTemplate">
      <CheckBox Margin="0,4,12,4" IsChecked="{Binding IsChecked}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" />
          <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </CheckBox>
    </DataTemplate>
  </Page.Resources>

    <StackPanel Margin="{StaticResource PagePadding}">

      <!-- Source: a subscription or one server. -->
      <ui:CardControl Margin="{StaticResource CardSpacing}" Visibility="{Binding ShowServerForm, Converter={StaticResource InverseBoolToVisibility}}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Cloud24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Сервер" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSubscription}" Value="True">
                        <Setter Property="Text" Value="Подписка" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Border Margin="10,0,0,0" Padding="8,1" CornerRadius="8" Background="#336CCB5F" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="11" Foreground="#6CCB5F" Text="туннель работает" />
              </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding ServerName}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceDetails}" Visibility="{Binding SourceDetails, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Style="{StaticResource Caption}" Foreground="#FFC857" Text="Есть серверы без проверки сертификата"
                       Visibility="{Binding HasInsecure, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Обновить" Command="{Binding RefreshSubscriptionCommand}" Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowSync24}"
                     Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Content="Добавить другую" Command="{Binding EditServerCommand}" Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}" />
          <ui:Button Content="Удалить" Command="{Binding RemoveServerCommand}" />
        </StackPanel>
      </ui:CardControl>

      <ui:Card Padding="20" Margin="{StaticResource CardSpacing}" Visibility="{Binding ShowServerForm, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Подписка или сервер" />
          <TextBlock Margin="0,4,0,12" Style="{StaticResource Caption}"
                     Text="Вставьте ссылку подписки из 3x-ui (https://…/sub/…) или ссылку одного сервера: vless://, hysteria2://, trojan://, ss://. Она хранится зашифрованной в папке, доступной только администраторам." />
          <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}" Text="Текущая подписка не удалится: она останется в «Сохранённых», и на неё можно будет переключиться."
                     Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}" />
          <ui:PasswordBox PlaceholderText="https://…/sub/…  или  vless://…" Password="{Binding ServerLink, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
          <TextBlock Margin="0,8,0,0" Foreground="#FF99A4" TextWrapping="Wrap" Text="{Binding ServerError}"
                     Visibility="{Binding ServerError, Converter={StaticResource NullToVisibility}}" />
          <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Отмена" Command="{Binding CancelEditServerCommand}" Margin="0,0,8,0"
                       Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Content="Сохранить" Appearance="Primary" Command="{Binding SaveServerCommand}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <!-- Previously used subscriptions and servers: switch back in one click. -->
      <ui:CardExpander Margin="{StaticResource CardSpacing}" IsExpanded="True" Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}">
        <ui:CardExpander.Icon>
          <ui:SymbolIcon Symbol="Bookmark24" />
        </ui:CardExpander.Icon>
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Сохранённые подписки" />
            <TextBlock Style="{StaticResource Caption}" Text="Раньше подключённые подписки и серверы. Выбранный в них сервер запоминается." />
          </StackPanel>
        </ui:CardExpander.Header>
        <ItemsControl ItemsSource="{Binding SavedSources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button Content="Переключиться" Margin="0,0,8,0"
                             Command="{Binding DataContext.SwitchSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding Id}" />
                  <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Удалить из сохранённых"
                             Command="{Binding DataContext.DeleteSavedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding Id}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ui:CardExpander>

      <!-- Master switch: stops sing-box completely, settings stay. -->
      <ui:CardControl Margin="{StaticResource CardSpacing}" Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Power24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="VPS" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Выключено — sing-box полностью остановлен, весь трафик идёт напрямую через zapret. Все настройки ниже сохраняются." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding VpnEnabled}" OffContent="Выкл" OnContent="Вкл" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <!-- Mode switch. -->
      <ui:CardControl Margin="{StaticResource CardSpacing}" Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}"
                      IsEnabled="{Binding VpnEnabled}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Globe24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Весь трафик через VPS" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Кроме российских сайтов и игр с маршрутом «Напрямую». Выключено — через VPS идёт только выбранное ниже." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding FullTunnel}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <!-- Servers. -->
      <StackPanel Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Серверы" />
        <ui:Card Padding="20,14" Margin="{StaticResource CardSpacing}">
          <StackPanel>
            <DockPanel Visibility="{Binding ManyServers, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
              <ui:Button DockPanel.Dock="Right" Content="Проверить пинг" Icon="{ui:SymbolIcon Gauge24}" Command="{Binding PingServersCommand}"
                         IsEnabled="{Binding IsPinging, Converter={StaticResource InverseBool}}" />
              <ui:ToggleSwitch DockPanel.Dock="Left" IsChecked="{Binding AutoBest}" VerticalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
              <StackPanel Margin="10,0,12,0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="Автовыбор лучшего сервера" />
                <TextBlock Style="{StaticResource Caption}" Text="Каждые 5 минут сравнивает пинг и переключает без разрыва. Пока идёт игра — не трогает." />
              </StackPanel>
            </DockPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Caption}" Text="{Binding PingStatus}" Visibility="{Binding PingStatus, Converter={StaticResource NullToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Servers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:Button Margin="0,2" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Appearance="Transparent"
                             Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                             ToolTip="Выбрать этот сервер (автовыбор выключится)">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding PingText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDown}" Value="True">
                                <Setter Property="Foreground" Value="#FF99A4" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </ui:Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>
      </StackPanel>

      <!-- Full tunnel: what stays direct. -->
      <StackPanel Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Visibility="{Binding FullTunnel, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Что оставить напрямую" />
          <ui:Card Padding="20" Margin="{StaticResource CardSpacing}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding DirectCategories}" ItemTemplate="{StaticResource CategoryTemplate}" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}"
                         Text="Игры с маршрутом «Напрямую» (и «Авто», если замер выбрал прямой путь) тоже идут мимо VPS, через zapret." />
            </StackPanel>
          </ui:Card>
        </StackPanel>

        <!-- Selective: what goes through the VPS. -->
        <StackPanel Visibility="{Binding FullTunnel, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Что пускать через VPS" />
          <ui:Card Padding="20" Margin="{StaticResource CardSpacing}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Категории" />
              <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="Готовые списки сайтов и адресов, обновляются раз в неделю. Галочка применяется сразу." />
              <ItemsControl ItemsSource="{Binding ProxyCategories}" ItemTemplate="{StaticResource CategoryTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="Программы" />
                  <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="Весь трафик программы идёт через VPS." />
                  <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddProgramCommand}" ToolTip="Добавить" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding RunningPrograms}" Text="{Binding NewProgram}" DropDownOpened="OnProgramsDropDown" />
                  </DockPanel>
                  <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Programs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,2" Padding="10,6" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                          <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Убрать"
                                       Command="{Binding DataContext.RemoveProgramCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontWeight="SemiBold" Text="Сайты" />
                  <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="По одному на строку, поддомены включаются. DNS для них тоже идёт через VPS." />
                  <ui:TextBox MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                              PlaceholderText="chatgpt.com" Text="{Binding DomainsText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </ui:Card>
        </StackPanel>

        <DockPanel Margin="0,0,0,4" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding ListsMessage}" />
          <ui:Button DockPanel.Dock="Right" Content="Сохранить" Appearance="Primary" Command="{Binding SaveListsCommand}" IsEnabled="{Binding ListsDirty}" />
        </DockPanel>
      </StackPanel>

      <!-- Quality. -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="Качество канала" />
      <ui:Card Padding="20" IsEnabled="{Binding HasServer}">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}"
                     Text="Сравнивает путь напрямую и через VPS до TLS-серверов игры (обычно её бэкенд в том же дата-центре) на уже открытом соединении." />
          <DockPanel Margin="0,12,0,0">
            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="130" Appearance="Primary" Content="{Binding MeasureButtonText}" Command="{Binding MeasureCommand}" Icon="{ui:SymbolIcon Gauge24}" />
            <ui:TextBox DockPanel.Dock="Right" Width="180" Margin="8,0,0,0" PlaceholderText="или IP:443" Text="{Binding CustomTarget, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" />
          </DockPanel>
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding TargetsHint}"
                     Visibility="{Binding TargetsHint, Converter={StaticResource NullToVisibility}}" />

          <ProgressBar Margin="0,14,0,0" Height="4" IsIndeterminate="True" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}" />

          <Grid Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Напрямую (zapret)" />
              <ContentPresenter Content="{Binding Direct}" ContentTemplate="{StaticResource PathStatsTemplate}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Через VPS" />
              <ContentPresenter Content="{Binding Tunnel}" ContentTemplate="{StaticResource PathStatsTemplate}" />
            </StackPanel>
          </Grid>

          <ui:InfoBar Margin="0,14,0,0" IsClosable="False" IsOpen="True" Severity="Informational" Message="{Binding Verdict}"
                      Visibility="{Binding Verdict, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </ui:Card>

      <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}">
        <Run Text="sing-box" />
        <Run Text="{Binding SingBoxVersion, Mode=OneWay}" />
      </TextBlock>
    </StackPanel>
</Page>

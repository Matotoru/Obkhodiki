<Page
  x:Class="Obkhodiki.App.Ui.Pages.BypassPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Обход блокировок">
    <StackPanel Margin="{StaticResource PagePadding}">

      <ui:CardControl Margin="{StaticResource CardSpacing}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="ShieldCheckmark24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Стратегия" />
            <TextBlock Style="{StaticResource Caption}">
              <Run Text="Способ обмана DPI из сборки Flowseal" />
              <Run Text="{Binding FlowsealVersion, StringFormat='{}{0}'}" />
            </TextBlock>
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox MinWidth="240" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" IsEnabled="{Binding IsSelecting, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <ui:CardControl Margin="{StaticResource CardSpacing}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Games24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Игровой фильтр" />
            <TextBlock Style="{StaticResource Caption}" Text="Для всех игр сразу, как в Flowseal. Точнее — профили на странице «Игры»." />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox MinWidth="240" DisplayMemberPath="Title" ItemsSource="{Binding GameFilterOptions}" SelectedItem="{Binding SelectedGameFilter}" IsEnabled="{Binding IsSelecting, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Автоподбор" />
      <ui:Card Padding="20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                       Text="Приложение включает стратегии по очереди и проверяет, открываются ли YouTube, Discord и сайты из списка целей. Сначала пробует те, что уже работали, и останавливается на первой, открывшей всё. «Проверить все» — полный прогон." />
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Margin="0,0,8,0" Content="Проверить все" Command="{Binding AutoSelectFullCommand}"
                       Visibility="{Binding IsSelecting, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button Appearance="Primary" Command="{Binding AutoSelectCommand}" MinWidth="160">
              <ui:Button.Style>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                  <Setter Property="Content" Value="Подобрать" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelecting}" Value="True">
                      <Setter Property="Content" Value="Остановить" />
                      <Setter Property="Appearance" Value="Secondary" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:Button.Style>
            </ui:Button>
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,16,0,0" Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Height="6" Maximum="1" Value="{Binding Progress}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding ProgressText}" />
          </StackPanel>

          <ui:InfoBar Margin="0,16,0,0" IsClosable="False" IsOpen="True" Severity="Informational"
                      Message="{Binding SelectionSummary}"
                      Visibility="{Binding SelectionSummary, Converter={StaticResource NullToVisibility}}" />

          <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4" ToolTip="{Binding Details}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="Star24" Filled="True" Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                 Visibility="{Binding IsBest, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                  <ProgressBar Grid.Column="2" Height="4" Margin="12,0" Maximum="1" Value="{Binding Ratio, Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding PassedText}" />
                  <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding LatencyText}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,1,0,2" Style="{StaticResource Caption}" TextWrapping="Wrap"
                             Text="{Binding FailedText}" Visibility="{Binding FailedText, Converter={StaticResource NullToVisibility}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Списки" />
      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding OpenListsCommand}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="List24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Мои списки сайтов и адресов" />
          <TextBlock Style="{StaticResource Caption}" Text="Ваши дополнения к спискам Flowseal. Обновления их не трогают." />
        </StackPanel>
      </ui:CardAction>
      <ui:CardAction Command="{Binding OpenTargetsCommand}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="Target24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Цели для автоподбора" />
          <TextBlock Style="{StaticResource Caption}" Text="Какие сайты проверять при подборе стратегии." />
        </StackPanel>
      </ui:CardAction>
    </StackPanel>
</Page>

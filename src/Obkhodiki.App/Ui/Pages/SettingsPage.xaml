<Page
  x:Class="Obkhodiki.App.Ui.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:Obkhodiki.App.Ui.ViewModels"
  Title="Настройки">
    <StackPanel Margin="{StaticResource PagePadding}">
      <ui:CardControl Margin="{StaticResource CardSpacing}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Rocket24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Запускать вместе с Windows" />
            <TextBlock Style="{StaticResource Caption}" Text="Без окна UAC при каждом входе. Приложение стартует свёрнутым в трей." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding Autostart}" />
      </ui:CardControl>

      <ui:CardControl Margin="{StaticResource CardSpacing}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="ArrowSync24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Проверять обновления при запуске" />
            <TextBlock Style="{StaticResource Caption}" Text="Только проверка — устанавливается всё после вашего подтверждения." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding CheckUpdatesOnStart}" />
      </ui:CardControl>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Оформление" />
      <ui:CardControl Margin="{StaticResource CardSpacing}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="DarkTheme24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Тема" />
            <TextBlock Style="{StaticResource Caption}" Text="«Как в Windows» переключается вместе с системой." />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox MinWidth="180" ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Theme}" />
      </ui:CardControl>
      <ui:Card Margin="{StaticResource CardSpacing}" Padding="20,14">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Цвет" />
          <TextBlock Style="{StaticResource Caption}" Text="У каждой палитры свой оттенок для светлой и тёмной темы, чтобы текст оставался читаемым." />
          <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Palettes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,14,8" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding Title}"
                        Command="{Binding DataContext.SelectPaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <StackPanel Width="64">
                        <Grid Width="36" Height="36" HorizontalAlignment="Center">
                          <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="0" />
                          <Ellipse Margin="4" Fill="{Binding Swatch}" />
                          <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Foreground="White"
                                         Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Title}" />
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <DataTrigger Value="True">
                          <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource ReferenceEquals}">
                              <Binding />
                              <Binding Path="DataContext.Palette" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                          </DataTrigger.Binding>
                          <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Ring" Property="StrokeThickness" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Компоненты" />
      <ItemsControl ItemsSource="{Binding Components}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="{StaticResource CardSpacing}" Padding="20,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Style="{StaticResource Caption}">
                    <Run Text="{Binding Description, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Version, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button Content="Проверить" Margin="0,0,8,0"
                             Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                  <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                             Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                             Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                    <TextBlock>
                      <Run Text="Установить" />
                      <Run Text="{Binding UpdateVersion, Mode=OneWay}" />
                    </TextBlock>
                  </ui:Button>
                </StackPanel>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding ShowWhatsNewCommand}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="Sparkle24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Что нового" />
          <TextBlock Style="{StaticResource Caption}" Text="Что добавилось в последних версиях." />
        </StackPanel>
      </ui:CardAction>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Перенос настроек" />
      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding ExportSettingsCommand}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="ArrowExportUp24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Сохранить настройки в файл" />
          <TextBlock Style="{StaticResource Caption}"
                     Text="Стратегия, игры с их адресами, списки, маршруты VPS и оформление. Подписки и ссылки серверов в файл не попадают." />
        </StackPanel>
      </ui:CardAction>
      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding ImportSettingsCommand}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="ArrowImport24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Загрузить настройки из файла" />
          <TextBlock Style="{StaticResource Caption}" Text="Заменит текущие настройки, игры и списки. Подписки VPS останутся как есть." />
        </StackPanel>
      </ui:CardAction>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Диагностика" />
      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding BuildReportCommand}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="DocumentBulletList24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Собрать отчёт" />
          <TextBlock Style="{StaticResource Caption}"
                     Text="Один zip-файл для того, кто помогает разобраться: состояние, проверка сайтов напрямую и через VPS, логи. Пароли, ключи и ссылки подписок вычищаются." />
        </StackPanel>
      </ui:CardAction>
      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding OpenLogCommand, Source={x:Static vm:ShellViewModel.Current}}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="Document24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Открыть лог" />
          <TextBlock Style="{StaticResource Caption}" Text="Пригодится, если что-то не работает." />
        </StackPanel>
      </ui:CardAction>

      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding OpenVpnLogCommand, Source={x:Static vm:ShellViewModel.Current}}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="Globe24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Открыть лог VPS" />
          <TextBlock Style="{StaticResource Caption}" Text="Журнал sing-box: ошибки соединения с сервером видны только в нём." />
        </StackPanel>
      </ui:CardAction>

      <ui:CardAction Margin="{StaticResource CardSpacing}" Command="{Binding OpenUserFolderCommand, Source={x:Static vm:ShellViewModel.Current}}">
        <ui:CardAction.Icon>
          <ui:SymbolIcon Symbol="Folder24" />
        </ui:CardAction.Icon>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Папка с моими данными" />
          <TextBlock Style="{StaticResource Caption}" Text="Ваши списки, цели для подбора и адреса игр." />
        </StackPanel>
      </ui:CardAction>

      <TextBlock Style="{StaticResource SectionTitle}" Text="Авторы и благодарности" />
      <ui:Card Padding="20,14" Margin="{StaticResource CardSpacing}">
        <StackPanel>
          <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                     Text="Obkhodiki сделан на основе этих проектов — спасибо их авторам. Нажмите на название, чтобы открыть проект." />
          <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Credits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center">
                    <Hyperlink Command="{Binding DataContext.OpenCreditCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                      <Run Text="{Binding Project, Mode=OneWay}" />
                    </Hyperlink>
                  </TextBlock>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Author, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Role, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding License}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>

      <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
        <Run Text="Obkhodiki" />
        <Run Text="{Binding AppVersion, Mode=OneWay}" />
        <Run Text="· автор matotoru" />
      </TextBlock>
    </StackPanel>
</Page>

<Page
  x:Class="Obkhodiki.App.Ui.Pages.WarpPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Cloudflare WARP">
  <Page.Resources>
    <DataTemplate x:Key="CategoryTemplate">
      <CheckBox Margin="0,4,12,4" IsChecked="{Binding IsChecked}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" />
          <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </CheckBox>
    </DataTemplate>
  </Page.Resources>

    <StackPanel Margin="{StaticResource PagePadding}">

      <!-- Master switch: the installed client, switched to its proxy mode while on. -->
      <ui:CardControl Margin="{StaticResource CardSpacing}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Cloud24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontWeight="SemiBold" Text="Cloudflare WARP" />
              <Border Margin="10,0,0,0" Padding="8,1" CornerRadius="8" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Подключён" />
              </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Отдельный путь рядом с «напрямую» и VPS, сервер не нужен. Работает через установленный Cloudflare WARP (One Client): Obkhodiki переводит его в режим прокси и при выключении возвращает прежний режим." />
            <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0"
                       Text="Cloudflare WARP не установлен — скачайте его с one.one.one.one"
                       Visibility="{Binding Installed, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding Enabled}" OffContent="Выкл" OnContent="Вкл" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <ui:InfoBar Margin="{StaticResource CardSpacing}" IsClosable="False" IsOpen="True" Severity="Informational" Title="Только TCP"
                  Message="Прокси WARP не передаёт UDP. Сайты и программы работают через TCP, а UDP (игры, звонки) идёт напрямую, мимо WARP. Для игр через сервер используйте VPS." />

      <!-- Mode switch. -->
      <ui:CardControl Margin="{StaticResource CardSpacing}" IsEnabled="{Binding Enabled}">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Globe24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Весь трафик через WARP" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Кроме российских сайтов, игр с маршрутом «Напрямую» и списка ниже. Отключает «Весь трафик через VPS»; выбранное на странице VPS по-прежнему идёт через сервер. Выключено — через WARP идёт только выбранное ниже." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding FullTunnel}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <StackPanel IsEnabled="{Binding Enabled}">
        <!-- Full tunnel: what stays direct. -->
        <StackPanel Visibility="{Binding FullTunnel, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Что оставить напрямую" />
          <ui:Card Padding="20" Margin="{StaticResource CardSpacing}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding DirectCategories}" ItemTemplate="{StaticResource CategoryTemplate}" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="Программы" />
                  <DockPanel Margin="0,8,0,0">
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddBypassProgramCommand}" ToolTip="Добавить" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding RunningPrograms}" Text="{Binding NewBypassProgram}" DropDownOpened="OnProgramsDropDown" />
                  </DockPanel>
                  <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding BypassPrograms}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,2" Padding="10,6" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                          <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Убрать"
                                       Command="{Binding DataContext.RemoveBypassProgramCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontWeight="SemiBold" Text="Сайты и адреса" />
                  <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="По одному на строку: домен (с поддоменами), IP или подсеть вида 10.0.0.0/8." />
                  <ui:TextBox MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                              PlaceholderText="sberbank.ru" Text="{Binding BypassText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                         Text="Список «Всегда напрямую» со страницы VPS тоже действует." />
            </StackPanel>
          </ui:Card>
        </StackPanel>

        <!-- Selective: what goes through WARP. -->
        <StackPanel Visibility="{Binding FullTunnel, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="Что пускать через WARP" />
          <ui:Card Padding="20" Margin="{StaticResource CardSpacing}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Категории" />
              <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" Text="Готовые списки сайтов и адресов, обновляются раз в неделю." />
              <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </ui:Card>
        </StackPanel>

        <!-- Explicit choices apply in both modes, like the VPS lists. -->
        <ui:Card Padding="20" Margin="{StaticResource CardSpacing}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Программы через WARP" />
              <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="TCP программы идёт через WARP, даже если она в списке VPS." />
              <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddProgramCommand}" ToolTip="Добавить" />
                <ComboBox IsEditable="True" ItemsSource="{Binding RunningPrograms}" Text="{Binding NewProgram}" DropDownOpened="OnProgramsDropDown" />
              </DockPanel>
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Programs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,2" Padding="10,6" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                      <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Убрать"
                                   Command="{Binding DataContext.RemoveProgramCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock FontWeight="SemiBold" Text="Сайты через WARP" />
              <TextBlock Margin="0,2,0,8" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="По одному на строку, поддомены включаются. Идут через WARP даже в режиме «весь трафик через VPS»." />
              <ui:TextBox MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                          PlaceholderText="gemini.google.com" Text="{Binding DomainsText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <DockPanel Margin="0,0,0,4" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding ListsMessage}" />
          <ui:Button DockPanel.Dock="Right" Content="Сохранить" Appearance="Primary" Command="{Binding SaveListsCommand}" IsEnabled="{Binding ListsDirty}" />
        </DockPanel>
      </StackPanel>

      <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                 Text="Способ подключения (туннель или системный прокси) и DNS xbox-dns.ru — общие, они на странице VPS." />
    </StackPanel>
</Page>

<Page
  x:Class="Obkhodiki.App.Ui.Pages.GamesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Игры">
    <StackPanel Margin="{StaticResource PagePadding}">

      <Grid Margin="0,0,0,12">
        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,300,0"
                   Text="Профиль игры применяет правила обхода только к её серверам — остальные сервисы не затрагиваются. Маршрут решает, идёт игра напрямую или через VPS." />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsLearningOpen, Converter={StaticResource InverseBoolToVisibility}}">
          <ui:Button Margin="0,0,8,0" Command="{Binding ImportGameCommand}" Icon="{ui:SymbolIcon ArrowImport24}" Content="Из файла" ToolTip="Загрузить игру, которой поделился друг" />
          <ui:Button Appearance="Primary" Command="{Binding AddGameCommand}" Icon="{ui:SymbolIcon Add24}" Content="Записать игру" />
        </StackPanel>
      </Grid>

      <!-- Learning panel: shown while adding or relearning a game. -->
      <ui:Card Padding="20" Margin="{StaticResource CardSpacing}" Visibility="{Binding IsLearningOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding LearningTitle}" />
          <TextBlock Margin="0,4,0,16" Style="{StaticResource Caption}"
                     Text="Запустите игру, выберите её процесс, нажмите «Начать запись» и сыграйте матч или зайдите в лобби. Потом остановите запись и сохраните." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="Процесс игры" Margin="0,0,0,4" />
              <DockPanel>
                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Обновить список"
                           Command="{Binding RefreshProcessesCommand}" IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Text="{Binding ProcessText}"
                          IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}" />
              </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Caption}" Text="Название" Margin="0,0,0,4" />
              <ui:TextBox PlaceholderText="Например, War Dogs" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <CheckBox Margin="0,14,0,0" IsChecked="{Binding BypassAll}" IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}"
                    Content="На время записи обходить для всех адресов (как ipset «any»), чтобы игра смогла подключиться" />
          <CheckBox Margin="0,6,0,0" IsChecked="{Binding ExpandAws}"
                    Content="Расширять адреса Amazon до их региональных диапазонов (серверы меняются от матча к матчу)" />

          <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="10" Height="10" Fill="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                       Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Caption}" Text="Адресов" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding AddressCount}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="TCP-порты" />
                <TextBlock FontSize="14" Margin="0,4,0,0" Text="{Binding TcpPorts}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Style="{StaticResource Caption}" Text="UDP-порты" />
                <TextBlock FontSize="14" Margin="0,4,0,0" Text="{Binding UdpPorts}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Отмена" Command="{Binding CancelLearningCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}" />
            <ui:Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" Icon="{ui:SymbolIcon Record24}" Margin="0,0,8,0" />
            <ui:Button Content="Сохранить" Appearance="Primary" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <!-- Profiles. -->
      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="{StaticResource CardSpacing}" Padding="20,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="112" Height="52" CornerRadius="6" Background="{Binding Gradient}" ClipToBounds="True">
                  <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White" Opacity="0.9"
                               Text="{Binding Initials}" Visibility="{Binding Cover, Converter={StaticResource InverseNullToVisibility}}" />
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.Clip>
                        <RectangleGeometry Rect="0,0,112,52" RadiusX="6" RadiusY="6" />
                      </Image.Clip>
                    </Image>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Caption}" Text="Маршрут" Margin="0,0,0,2" />
                  <ComboBox Width="240" ItemsSource="{Binding RouteOptions}" DisplayMemberPath="Title" SelectedItem="{Binding Route}">
                    <!-- Without a VPS only "Direct" is selectable, but the box stays usable to switch back to it. -->
                    <ComboBox.ItemContainerStyle>
                      <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="IsEnabled" Value="{Binding DataContext.VpnAvailable, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Route}" Value="Direct">
                            <Setter Property="IsEnabled" Value="True" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ComboBox.ItemContainerStyle>
                  </ComboBox>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="3" VerticalAlignment="Center" IsChecked="{Binding Enabled}" Margin="0,0,8,0" />
                <ui:DropDownButton Grid.Column="4" VerticalAlignment="Center" Icon="{ui:SymbolIcon MoreHorizontal24}">
                  <ui:DropDownButton.Flyout>
                    <ContextMenu>
                      <MenuItem Header="Дообучить (записать ещё)" Command="{Binding RelearnCommand}" />
                      <MenuItem Header="Открыть список адресов" Command="{Binding OpenAddressesCommand}" />
                      <MenuItem Header="Поделиться…" Command="{Binding ShareCommand}" />
                      <MenuItem Header="Своя картинка…" Command="{Binding ChooseCoverCommand}" />
                      <MenuItem Header="Убрать свою картинку" Command="{Binding RemoveCoverCommand}"
                                Visibility="{Binding HasCustomCover, Converter={StaticResource BoolToVisibility}}" />
                      <Separator />
                      <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                  </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:Card Padding="28" Margin="{StaticResource CardSpacing}" Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center">
          <ui:SymbolIcon Symbol="Games24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Игр пока нет" />
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Нажмите «Добавить игру», чтобы записать её серверы." />
        </StackPanel>
      </ui:Card>

      <!-- Built-in profiles: one click instead of recording. -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="Популярные игры" />
      <TextBlock Margin="0,-4,0,12" Style="{StaticResource Caption}"
                 Text="«Работает сразу» — адреса серверов программа берёт из открытых реестров сетей. Для остальных после добавления запустите игру и запишите один матч." />
      <ItemsControl ItemsSource="{Binding Catalog}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Width="248" Margin="0,0,12,12" Padding="0">
              <StackPanel>
                <Border Height="116" CornerRadius="8,8,0,0" Background="{Binding Gradient}" ClipToBounds="True">
                  <Grid>
                    <TextBlock Margin="14" VerticalAlignment="Bottom" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"
                               Text="{Binding Name}" Visibility="{Binding Cover, Converter={StaticResource InverseNullToVisibility}}">
                      <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5" />
                      </TextBlock.Effect>
                    </TextBlock>
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.Clip>
                        <RectangleGeometry Rect="0,0,248,116" RadiusX="8" RadiusY="8" />
                      </Image.Clip>
                    </Image>
                  </Grid>
                </Border>
                <Grid Margin="14,10,14,12" Height="52">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding AddText}" Command="{Binding AddCommand}"
                             IsEnabled="{Binding IsAdded, Converter={StaticResource InverseBool}}">
                    <ui:Button.Style>
                      <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Primary" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAdded}" Value="True">
                            <Setter Property="Appearance" Value="Secondary" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:Button.Style>
                  </ui:Button>
                </Grid>
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
</Page>

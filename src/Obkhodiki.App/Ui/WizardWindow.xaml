<ui:FluentWindow
  x:Class="Obkhodiki.App.Ui.WizardWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Obkhodiki — первый запуск"
  Width="820"
  Height="640"
  MinWidth="720"
  MinHeight="560"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResize"
  ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Первый запуск" ShowMaximize="False" ShowMinimize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Obkhodiki;component/Assets/cat.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <StackPanel Grid.Row="1" Margin="32,8,32,12">
      <TextBlock Style="{StaticResource Caption}" Text="{Binding StepText}" />
      <TextBlock Margin="0,2,0,6" FontSize="24" FontWeight="SemiBold" Text="{Binding StepTitle}" />
      <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StepCaption}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Margin="32,0,20,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
      <Grid>
        <!-- 1. Welcome -->
        <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" Margin="0,24,0,0">
          <Image Width="190" Source="pack://application:,,,/Obkhodiki;component/Assets/cat.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <UniformGrid Margin="0,24,0,0" Columns="3">
            <StackPanel Margin="8">
              <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Обход блокировок" />
            </StackPanel>
            <StackPanel Margin="8">
              <ui:SymbolIcon Symbol="Games24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Игры" />
            </StackPanel>
            <StackPanel Margin="8">
              <ui:SymbolIcon Symbol="Globe24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Свой VPS" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>

        <!-- 2. Strategy -->
        <Grid Visibility="{Binding IsStrategy, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding Shell.Bypass}">
          <ui:Card Padding="20">
            <StackPanel>
              <DockPanel>
                <ui:Button DockPanel.Dock="Right" Command="{Binding AutoSelectCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Search24}">
                  <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Content" Value="Подобрать" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelecting}" Value="True">
                          <Setter Property="Content" Value="Остановить" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock FontWeight="SemiBold" Text="{Binding SelectedStrategy, StringFormat=Сейчас: {0}}" />
                  <TextBlock Style="{StaticResource Caption}" Text="Во время подбора интернет может ненадолго пропадать — это нормально." />
                </StackPanel>
              </DockPanel>
              <ProgressBar Margin="0,16,0,0" Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                           Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding ProgressText}"
                         Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}" />
              <ui:InfoBar Margin="0,12,0,0" IsClosable="False" IsOpen="True" Severity="Success" Message="{Binding SelectionSummary}"
                          Visibility="{Binding SelectionSummary, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
          </ui:Card>
        </StackPanel>
        </Grid>

        <!-- 3. Games -->
        <ItemsControl Visibility="{Binding IsGames, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding Shell.Games.Catalog}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Width="178" Margin="0,0,10,10" Padding="0">
                <StackPanel>
                  <Border Height="83" CornerRadius="8,8,0,0" Background="{Binding Gradient}" ClipToBounds="True">
                    <Grid>
                      <TextBlock Margin="10" VerticalAlignment="Bottom" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"
                                 Text="{Binding Name}" Visibility="{Binding Cover, Converter={StaticResource InverseNullToVisibility}}" />
                      <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                          <RectangleGeometry Rect="0,0,178,83" RadiusX="8" RadiusY="8" />
                        </Image.Clip>
                      </Image>
                    </Grid>
                  </Border>
                  <StackPanel Margin="10,8,10,10">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <ui:Button Margin="0,6,0,0" Padding="10,4" HorizontalAlignment="Stretch" Content="{Binding AddText}" Command="{Binding AddCommand}"
                               IsEnabled="{Binding IsAdded, Converter={StaticResource InverseBool}}" />
                  </StackPanel>
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 4. VPS -->
        <Grid Visibility="{Binding IsVpn, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding Shell.Vpn}">
          <ui:Card Padding="20" Visibility="{Binding HasServer, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
              <ui:PasswordBox PlaceholderText="https://…/sub/…  или  vless://…" Password="{Binding ServerLink, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
              <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ServerError}"
                         Visibility="{Binding ServerError, Converter={StaticResource NullToVisibility}}" />
              <ui:Button Margin="0,12,0,0" HorizontalAlignment="Right" Appearance="Primary" Content="Добавить" Command="{Binding SaveServerCommand}" />
            </StackPanel>
          </ui:Card>
          <ui:InfoBar IsClosable="False" IsOpen="True" Severity="Success" Title="VPS добавлен" Message="{Binding ServerName}"
                      Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        </Grid>

        <!-- 5. Look -->
        <Grid Visibility="{Binding IsLook, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding Shell.Settings}">
          <ui:CardControl Margin="{StaticResource CardSpacing}">
            <ui:CardControl.Icon>
              <ui:SymbolIcon Symbol="DarkTheme24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
              <TextBlock FontWeight="SemiBold" Text="Тема" />
            </ui:CardControl.Header>
            <ComboBox MinWidth="180" ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Theme}" />
          </ui:CardControl>
          <ui:Card Padding="20,14">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Цвет" />
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Palettes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,14,8" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding Title}"
                        Command="{Binding DataContext.SelectPaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <StackPanel Width="64">
                        <Grid Width="36" Height="36" HorizontalAlignment="Center">
                          <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="0" />
                          <Ellipse Margin="4" Fill="{Binding Swatch}" />
                          <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Foreground="White"
                                         Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Title}" />
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <DataTrigger Value="True">
                          <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource ReferenceEquals}">
                              <Binding />
                              <Binding Path="DataContext.Palette" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                          </DataTrigger.Binding>
                          <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Ring" Property="StrokeThickness" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
            </StackPanel>
          </ui:Card>
        </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="3" Padding="32,14" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <DockPanel LastChildFill="False">
        <ui:Button DockPanel.Dock="Left" Content="Пропустить мастер" Appearance="Transparent" Command="{Binding FinishCommand}"
                   Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}" />
        <ui:Button DockPanel.Dock="Right" MinWidth="110" Appearance="Primary" Content="{Binding NextText}" Command="{Binding NextCommand}" />
        <ui:Button DockPanel.Dock="Right" Margin="0,0,8,0" Content="Назад" Command="{Binding BackCommand}"
                   Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>

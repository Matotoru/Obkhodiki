<ui:FluentWindow
  x:Class="Obkhodiki.App.Ui.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:pages="clr-namespace:Obkhodiki.App.Ui.Pages"
  Title="Obkhodiki"
  Width="1120"
  Height="740"
  Icon="pack://application:,,,/Obkhodiki;component/Assets/Obkhodiki.ico"
  MinWidth="860"
  MinHeight="560"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Faint mascot behind the pages. -->
    <Image
      Grid.Row="1"
      Width="420"
      Margin="0,0,-40,-60"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      IsHitTestVisible="False"
      Opacity="0.07"
      RenderOptions.BitmapScalingMode="HighQuality"
      Source="pack://application:,,,/Obkhodiki;component/Assets/cat.png" />

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleVisible="True"
      OpenPaneLength="220"
      PaneDisplayMode="Left"
      Navigated="OnNavigated">
      <ui:NavigationView.Header>
        <TextBlock x:Name="PageTitle" Margin="32,20,0,16" FontSize="28" FontWeight="SemiBold" />
      </ui:NavigationView.Header>
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Главная" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:HomePage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Обход" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:BypassPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="ShieldCheckmark24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Игры" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:GamesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Games24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="VPS" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:VpnPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Globe24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Telegram" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:TelegramPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Send24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.PaneFooter>
        <StackPanel Margin="18,2,12,10" Orientation="Horizontal">
          <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
          <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
            <Hyperlink x:Name="AuthorLink" Click="OnAuthorClick" ToolTip="GitHub автора">matotoru</Hyperlink>
          </TextBlock>
        </StackPanel>
      </ui:NavigationView.PaneFooter>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="Настройки" NavigationCacheMode="Enabled" TargetPageType="{x:Type pages:SettingsPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Obkhodiki">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Obkhodiki;component/Assets/cat.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Notifications from any page land here, so an error is visible wherever the user is. -->
    <ui:SnackbarPresenter x:Name="Snackbars" Grid.Row="1" VerticalAlignment="Bottom" Margin="240,0,24,16" />

    <!-- Busy indicator: whatever long operation is running, the user sees it without opening a page. -->
    <Border
      Grid.Row="0"
      Margin="0,6,150,0"
      Padding="10,4"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      CornerRadius="12"
      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
        <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Text="{Binding BusyText}" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
